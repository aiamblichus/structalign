{
  "name": "structalign",
  "version": "0.2.2",
  "description": "StructAlign: TypeScript implementation of schema-aligned parsing (SAP) using TypeBox",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:examples": "tsc -p tsconfig.examples.json",
    "build:tests": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "test": "pnpm run build:tests && node --test dist/tests/*.js",
    "example": "pnpm run build:examples && node dist/examples/basic-usage.js",
    "lint": "biome lint src tests examples",
    "lint:fix": "biome lint --write src tests examples",
    "format": "biome format src tests examples",
    "format:fix": "biome format --write src tests examples",
    "check": "biome check src tests examples",
    "check:fix": "biome check --write src tests examples",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "preversion": "pnpm run check && pnpm test",
    "release:patch": "pnpm version patch && git push --follow-tags && pnpm publish",
    "release:minor": "pnpm version minor && git push --follow-tags && pnpm publish",
    "release:major": "pnpm version major && git push --follow-tags && pnpm publish",
    "release:dry-run": "pnpm pack --dry-run"
  },
  "keywords": [
    "baml",
    "sap",
    "schema-aligned-parsing",
    "llm",
    "structured-output",
    "typebox",
    "json-extraction",
    "prompt-engineering",
    "ai",
    "openai",
    "anthropic"
  ],
  "author": "aiamblichus <aiamblichus@fastmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiamblichus/structalign.git"
  },
  "bugs": {
    "url": "https://github.com/aiamblichus/structalign/issues"
  },
  "homepage": "https://github.com/aiamblichus/structalign#readme",
  "dependencies": {
    "typebox": "^1.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
